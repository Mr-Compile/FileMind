<Page
    x:Class="FileMind.WinUI.Shell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FileMind.WinUI.Controls">
    <!-- platforms/windows.md shell matched to mockup/index.html:
         titlebar (brand mark + name | command search | op-center+density+theme),
         left rail, breadcrumb + content. -->
    <Grid Background="{ThemeResource FmSurfaceBackgroundBrush}">

        <!-- Titlebar — mockup .titlebar: 48px, surface, bottom border -->
        <Border x:Name="TitleBar" Height="48" VerticalAlignment="Top"
                Background="{ThemeResource FmSurfacePrimaryBrush}"
                BorderThickness="0,0,0,1" BorderBrush="{ThemeResource FmBorderBrush}">
            <Grid ColumnSpacing="{StaticResource FmSpace2}" Padding="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="ms-appx:///Images/filemind-mark.png" Width="26" Height="26"
                       VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock Grid.Column="1" Text="FileMind"
                           Style="{StaticResource FmTextBody}" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <!-- drag region -->
                <Rectangle Grid.Column="2" Fill="Transparent" />
                <AutoSuggestBox Grid.Column="3" x:Name="GlobalSearch"
                    PlaceholderText="Search files or type a command…" QueryIcon="Find"
                    VerticalAlignment="Center" QuerySubmitted="GlobalSearch_QuerySubmitted" />
                <Grid Grid.Column="4" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button x:Name="OpCenterButton"
                            AutomationProperties.Name="Operation center"
                            ToolTipService.ToolTip="Operation center"
                            Width="36" Height="36" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            Click="OpCenterButton_Click">
                        <FontIcon Glyph="&#xE81C;" FontSize="16" />
                    </Button>
                    <InfoBadge x:Name="OpBadge" Value="1" Visibility="Collapsed"
                               HorizontalAlignment="Right" VerticalAlignment="Top"
                               Margin="0,1,1,0" IsHitTestVisible="False" />
                </Grid>
                <Button Grid.Column="5" x:Name="DensityButton"
                        AutomationProperties.Name="Toggle compact density"
                        ToolTipService.ToolTip="Toggle compact density"
                        Width="36" Height="36" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Click="DensityButton_Click">
                    <FontIcon Glyph="&#xE8FD;" FontSize="16" />
                </Button>
                <Button Grid.Column="6" x:Name="ThemeButton"
                        AutomationProperties.Name="Change theme"
                        ToolTipService.ToolTip="Theme: System / Light / Dark"
                        Width="36" Height="36" Padding="0"
                        Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xE790;" FontSize="16" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <RadioMenuFlyoutItem x:Name="ThemeSystem" Text="System" GroupName="theme"
                                                 IsChecked="True" Click="ThemeItem_Click" Tag="system" />
                            <RadioMenuFlyoutItem x:Name="ThemeLight" Text="Light" GroupName="theme"
                                                 Click="ThemeItem_Click" Tag="light" />
                            <RadioMenuFlyoutItem x:Name="ThemeDark" Text="Dark" GroupName="theme"
                                                 Click="ThemeItem_Click" Tag="dark" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </Border>

        <NavigationView
            x:Name="Nav" Margin="0,48,0,0"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left" IsPaneOpen="True" IsPaneToggleButtonVisible="True"
            SelectionChanged="Nav_SelectionChanged"
            OpenPaneLength="212">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Tag="dashboard">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Files" Tag="files">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Organizer" Tag="organizer">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8F0;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Tools" Tag="tools">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8C7;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Search" Tag="search">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE721;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Devices" Tag="devices">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEDA2;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Activity" Tag="activity">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Settings" Tag="settings">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItemHeader Content="Developer" />
                <NavigationViewItem Content="Component gallery" Tag="gallery">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8FD;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- content column: breadcrumb + page -->
            <Grid RowSpacing="{StaticResource FmSpace2}" Padding="{StaticResource FmPadContent}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <BreadcrumbBar x:Name="Crumbs" Margin="-12,0,0,0" />
                <Frame Grid.Row="1" x:Name="ContentFrame" />
            </Grid>
        </NavigationView>
    </Grid>
</Page>
