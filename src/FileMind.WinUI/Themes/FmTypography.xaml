<?xml version="1.0" encoding="utf-8"?>
<!-- PLAN-014 M1.1 — type ramp per foundations/03-typography-fonts.md.
     Segoe UI Variable w/ system fallback; sizes follow the Fluent ramp. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="FmFontFamily">Segoe UI Variable Display, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="FmFontMono">Cascadia Mono, Consolas, monospace</FontFamily>

    <Style x:Key="FmTextDisplay" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FmFontFamily}" />
        <Setter Property="FontSize" Value="42" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- Ramp matched to the canonical mockup (mockup/styles.css):
         h1 22/600 page title · h2 16/600 section · h3 13/600 card -->
    <Style x:Key="FmTextH1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FmFontFamily}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="FmTextH2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FmFontFamily}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="FmTextH3" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FmFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="FmTextBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FmFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style x:Key="FmTextBodySmall" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FmFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style x:Key="FmTextLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FmFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="FmTextMono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FmFontMono}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
</ResourceDictionary>
