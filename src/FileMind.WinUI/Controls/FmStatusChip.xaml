<UserControl
    x:Class="FileMind.WinUI.Controls.FmStatusChip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- components/03: every state gets icon + label + semantic color.
         Never color-only; non-interactive by default. -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="StInfo" Color="{ThemeResource FmStatusInfoColor}" />
        <SolidColorBrush x:Key="StSuccess" Color="{ThemeResource FmStatusSuccessColor}" />
        <SolidColorBrush x:Key="StWarning" Color="{ThemeResource FmStatusWarningColor}" />
        <SolidColorBrush x:Key="StError" Color="{ThemeResource FmStatusErrorColor}" />
        <SolidColorBrush x:Key="StNeutral" Color="{ThemeResource FmStatusNeutralColor}" />
        <SolidColorBrush x:Key="StOffline" Color="{ThemeResource FmStatusOfflineColor}" />
    </UserControl.Resources>
    <Border
        x:Name="ChipRoot"
        Padding="{StaticResource FmPadChip}"
        CornerRadius="{StaticResource FmRadiusPillValue}"
        BorderThickness="1">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource FmSpace2}">
            <FontIcon x:Name="ChipIcon" FontSize="12" />
            <TextBlock x:Name="ChipLabel" Style="{StaticResource FmTextLabel}" />
        </StackPanel>
    </Border>
</UserControl>
