<Page
    x:Class="FileMind.WinUI.Views.GalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FileMind.WinUI.Controls">
    <ScrollViewer Background="{ThemeResource FmSurfaceBackgroundBrush}">
        <StackPanel Padding="{StaticResource FmPad6}" Spacing="{StaticResource FmSpace6}">

            <TextBlock Text="Component gallery" Style="{StaticResource FmTextH1}" />

            <!-- buttons/actions -->
            <StackPanel Spacing="{StaticResource FmSpace2}">
                <TextBlock Text="Actions" Style="{StaticResource FmTextH2}" />
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource FmSpace2}">
                    <Button Content="Primary" Style="{StaticResource AccentButtonStyle}" />
                    <Button Content="Default" />
                    <Button Content="Disabled" IsEnabled="False" />
                </StackPanel>
            </StackPanel>

            <!-- chips/status: all 12 operation states -->
            <StackPanel Spacing="{StaticResource FmSpace2}">
                <TextBlock Text="Status chips (12-state model)" Style="{StaticResource FmTextH2}" />
                <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="6">
                    <c:FmStatusChip State="Ready" Margin="0,0,8,8" />
                    <c:FmStatusChip State="Queued" Margin="0,0,8,8" />
                    <c:FmStatusChip State="Checking" Margin="0,0,8,8" />
                    <c:FmStatusChip State="Running" Detail="3 of 10" Margin="0,0,8,8" />
                    <c:FmStatusChip State="Paused" Margin="0,0,8,8" />
                    <c:FmStatusChip State="Completed" Margin="0,0,8,8" />
                    <c:FmStatusChip State="CompletedWithWarnings" Margin="0,0,8,8" />
                    <c:FmStatusChip State="Failed" Margin="0,0,8,8" />
                    <c:FmStatusChip State="Cancelled" Margin="0,0,8,8" />
                    <c:FmStatusChip State="Offline" Margin="0,0,8,8" />
                    <c:FmStatusChip State="Unsupported" Margin="0,0,8,8" />
                    <c:FmStatusChip State="PermissionRequired" Margin="0,0,8,8" />
                </VariableSizedWrapGrid>
            </StackPanel>

            <!-- progress -->
            <StackPanel Spacing="{StaticResource FmSpace2}" MaxWidth="480">
                <TextBlock Text="Progress" Style="{StaticResource FmTextH2}" />
                <ProgressBar Value="62" Maximum="100" />
                <ProgressBar IsIndeterminate="True" />
            </StackPanel>

            <!-- bento card -->
            <c:FmBentoCard Header="Bento card" IconGlyph="&#xEDA2;" MaxWidth="420">
                <c:FmBentoCard.CardContent>
                    <TextBlock Style="{StaticResource FmTextBody}" TextWrapping="Wrap"
                        Text="Surface/primary card on the page background — elevation tier 1." />
                </c:FmBentoCard.CardContent>
                <c:FmBentoCard.FooterContent>
                    <Button Content="Footer action" />
                </c:FmBentoCard.FooterContent>
            </c:FmBentoCard>

            <!-- state contract: all six component states -->
            <StackPanel Spacing="{StaticResource FmSpace2}">
                <TextBlock Text="State views (component contract)" Style="{StaticResource FmTextH2}" />
                <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3">
                    <c:FmStateView State="Idle" Title="Idle" Body="Ready and waiting." Margin="0,0,24,24" />
                    <c:FmStateView State="Loading" Title="Loading" Body="Working on it…" Margin="0,0,24,24" />
                    <c:FmStateView State="Success" Title="Done" Body="Finished cleanly."
                                   ActionLabel="View result" Margin="0,0,24,24" />
                    <c:FmStateView State="Empty" Title="Nothing here"
                                   Body="No files match yet." ActionLabel="Scan a folder" Margin="0,0,24,24" />
                    <c:FmStateView State="Warning" Title="Heads up"
                                   Body="Some items need review." Margin="0,0,24,24" />
                    <c:FmStateView State="Error" Title="Something went wrong"
                                   Body="Check Activity for details."
                                   ActionLabel="Retry" Margin="0,0,24,24" />
                </VariableSizedWrapGrid>
            </StackPanel>

            <!-- friendly error -->
            <StackPanel Spacing="{StaticResource FmSpace2}" MaxWidth="480">
                <TextBlock Text="Friendly error (ux/06)" Style="{StaticResource FmTextH2}" />
                <StackPanel x:Name="ErrorSample" Spacing="{StaticResource FmSpace2}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
