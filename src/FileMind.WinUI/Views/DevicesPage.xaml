<Page
    x:Class="FileMind.WinUI.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FileMind.WinUI.Controls">
    <ScrollViewer>
        <StackPanel Padding="{StaticResource FmPad6}" Spacing="{StaticResource FmSpace4}" MaxWidth="800">
            <TextBlock Text="Devices" Style="{StaticResource FmTextH1}" />
            <c:FmBentoCard IconGlyph="&#xEDA2;" Header="This PC">
                <c:FmBentoCard.CardContent>
                    <StackPanel Spacing="{StaticResource FmSpace2}">
                        <TextBlock x:Name="PcName" Style="{StaticResource FmTextH3}" />
                        <TextBlock x:Name="PcDetail" Style="{StaticResource FmTextBodySmall}"
                                   Foreground="{ThemeResource FmTextSecondaryBrush}" />
                        <ItemsRepeater x:Name="DriveList">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource FmTextBody}" Padding="0,2" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </c:FmBentoCard.CardContent>
            </c:FmBentoCard>
            <c:FmBentoCard IconGlyph="&#xE8EA;" Header="Android">
                <c:FmBentoCard.CardContent>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource FmSpace2}">
                        <c:FmStatusChip State="Unsupported" Detail="Planned" />
                        <TextBlock Style="{StaticResource FmTextBodySmall}" VerticalAlignment="Center"
                                   Text="Android support is planned (PLAN-010) — nothing is connected yet."
                                   Foreground="{ThemeResource FmTextSecondaryBrush}" />
                    </StackPanel>
                </c:FmBentoCard.CardContent>
            </c:FmBentoCard>
        </StackPanel>
    </ScrollViewer>
</Page>
