<Page
    x:Class="FileMind.WinUI.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FileMind.WinUI.Controls">
    <!-- matched to mockup screens.js "devices": page-head + device card grid
         (meter, capabilities, restriction badges, browse/organize actions) -->
    <ScrollViewer>
        <StackPanel Spacing="{StaticResource FmSpace6}">
            <StackPanel>
                <TextBlock Text="Devices" Style="{StaticResource FmTextH1}" />
                <TextBlock Style="{StaticResource FmTextBodySmall}"
                           Foreground="{ThemeResource FmTextSecondaryBrush}"
                           Text="Connected storage and what FileMind is allowed to do on each." />
            </StackPanel>

            <Grid ColumnSpacing="{StaticResource FmSpace4}" RowSpacing="{StaticResource FmSpace4}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition /><ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- This PC — real drive data -->
                <c:FmBentoCard Header="This PC">
                    <c:FmBentoCard.HeaderTrailing>
                        <Border Style="{StaticResource FmBadgeBorder}">
                            <TextBlock Text="Connected" FontSize="11"
                                       Foreground="{ThemeResource FmStatusSuccessBrush}" />
                        </Border>
                    </c:FmBentoCard.HeaderTrailing>
                    <c:FmBentoCard.CardContent>
                        <StackPanel Spacing="{StaticResource FmSpace2}">
                            <TextBlock x:Name="PcName" Style="{StaticResource FmTextH3}" />
                            <TextBlock x:Name="PcDetail" Style="{StaticResource FmTextBodySmall}"
                                       Foreground="{ThemeResource FmTextSecondaryBrush}" />
                            <Grid x:Name="DriveMeter" Height="8" Margin="0,6,0,0">
                                <Border CornerRadius="999" Background="{ThemeResource FmSurfaceElevatedBrush}" />
                                <Border x:Name="DriveMeterFill" CornerRadius="999"
                                        Background="{ThemeResource FmAccentBrush}"
                                        HorizontalAlignment="Left" />
                            </Grid>
                            <TextBlock x:Name="DriveSummary" Style="{StaticResource FmTextBodySmall}"
                                       Foreground="{ThemeResource FmTextSecondaryBrush}" />
                            <ItemsRepeater x:Name="DriveList">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource FmTextBodySmall}"
                                                   Padding="0,2" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                            <TextBlock Style="{StaticResource FmTextBodySmall}" Margin="0,6,0,0"
                                       Text="Capabilities — read, move, rename (copy-on-move across volumes), index, watch folders"
                                       Foreground="{ThemeResource FmTextSecondaryBrush}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                <Button Content="Browse" Click="Browse_Click" />
                                <Button Content="Organize" Click="Organize_Click" />
                            </StackPanel>
                        </StackPanel>
                    </c:FmBentoCard.CardContent>
                </c:FmBentoCard>

                <!-- Android — truthful companion status -->
                <c:FmBentoCard Grid.Column="1" Header="Android phone">
                    <c:FmBentoCard.HeaderTrailing>
                        <Border Style="{StaticResource FmBadgeBorder}">
                            <TextBlock Text="Disconnected" FontSize="11"
                                       Foreground="{ThemeResource FmTextSecondaryBrush}" />
                        </Border>
                    </c:FmBentoCard.HeaderTrailing>
                    <c:FmBentoCard.CardContent>
                        <StackPanel Spacing="{StaticResource FmSpace2}">
                            <TextBlock Text="FileMind companion" Style="{StaticResource FmTextH3}" />
                            <TextBlock Style="{StaticResource FmTextBodySmall}"
                                       Foreground="{ThemeResource FmTextSecondaryBrush}"
                                       Text="Storage reporting needs a paired device." TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource FmTextBodySmall}" Margin="0,6,0,0"
                                       Text="Capabilities — MediaStore scan, SAF folders, WorkManager jobs, share target (companion app)"
                                       Foreground="{ThemeResource FmTextSecondaryBrush}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                <Border Style="{StaticResource FmBadgeBorder}">
                                    <TextBlock Text="SAF scoped storage" FontSize="11"
                                               Foreground="{ThemeResource FmStatusWarningBrush}" />
                                </Border>
                                <Border Style="{StaticResource FmBadgeBorder}">
                                    <TextBlock Text="background limits" FontSize="11"
                                               Foreground="{ThemeResource FmStatusWarningBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource FmTextBodySmall}" Margin="0,8,0,0"
                                       Text="Connect the phone with the FileMind Android app to browse or organize it from here."
                                       Foreground="{ThemeResource FmTextSecondaryBrush}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                <Button Content="Browse" IsEnabled="False" />
                                <Button Content="Organize" IsEnabled="False" />
                            </StackPanel>
                        </StackPanel>
                    </c:FmBentoCard.CardContent>
                </c:FmBentoCard>

                <!-- Removable drives -->
                <ItemsRepeater Grid.Row="1" Grid.ColumnSpan="2" x:Name="RemovableList" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
