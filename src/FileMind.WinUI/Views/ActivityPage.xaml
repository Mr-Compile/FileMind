<Page
    x:Class="FileMind.WinUI.Views.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FileMind.WinUI.Controls">
    <!-- matched to mockup screens.js "activity": operations list w/ undo,
         Smart Inbox section w/ resolve, canonical states legend -->
    <ScrollViewer>
        <StackPanel Spacing="{StaticResource FmSpace6}">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Activity" Style="{StaticResource FmTextH1}" />
                    <TextBlock Style="{StaticResource FmTextBodySmall}"
                               Foreground="{ThemeResource FmTextSecondaryBrush}"
                               Text="Operation center — history, undo, and the Smart Inbox." />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Content="Refresh" Click="Refresh_Click" />
            </Grid>

            <!-- active operations (mockup shows in-flight ops above history) -->
            <StackPanel x:Name="ActiveSection" Spacing="{StaticResource FmSpace2}"
                        Visibility="Collapsed">
                <TextBlock Text="Active now" Style="{StaticResource FmTextH2}" />
                <ItemsControl x:Name="ActiveList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{ThemeResource FmSurfacePrimaryBrush}"
                                    BorderBrush="{ThemeResource FmBorderBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource FmRadiusMediumValue}"
                                    Padding="12,8" Margin="0,0,0,6">
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <c:FmStatusChip State="{Binding State}" />
                                        <TextBlock Text="{Binding OpId}" FontSize="11"
                                                   Foreground="{ThemeResource FmTextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100"
                                                 Height="6" />
                                    <TextBlock Text="{Binding Summary}" FontSize="12"
                                               Foreground="{ThemeResource FmTextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="{StaticResource FmSpace2}">
                <TextBlock Text="Operations" Style="{StaticResource FmTextH2}" />
                <ListView x:Name="OpList" SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="12" Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <c:FmStatusChip State="{Binding State}" />
                                        <TextBlock Text="{Binding OpId}" FontSize="11"
                                                   Foreground="{ThemeResource FmTextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                        <Border Style="{StaticResource FmBadgeBorder}"
                                                Visibility="{Binding UndoBadgeVisibility}">
                                            <TextBlock Text="undo" FontSize="11"
                                                       Foreground="{ThemeResource FmTextSecondaryBrush}" />
                                        </Border>
                                        <TextBlock Text="{Binding When}" FontSize="11"
                                                   Foreground="{ThemeResource FmTextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Summary}" FontSize="12"
                                               Foreground="{ThemeResource FmTextSecondaryBrush}" />
                                    <Expander Header="{Binding ItemsHeader}" FontSize="12">
                                        <TextBlock Text="{Binding ItemsDetail}" FontFamily="Consolas"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource FmTextSecondaryBrush}" />
                                    </Expander>
                                </StackPanel>
                                <Button Grid.Column="1" VerticalAlignment="Top"
                                        Content="Undo" Click="UndoRow_Click"
                                        Visibility="{Binding UndoVisibility}"
                                        Tag="{Binding OperationId}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <c:FmStateView x:Name="OpsEmpty" State="Empty" Title="No operations yet"
                    Body="Organized files and their undo history appear here."
                    Visibility="Collapsed" />
            </StackPanel>

            <StackPanel Spacing="{StaticResource FmSpace2}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Smart Inbox" Style="{StaticResource FmTextH2}"
                               VerticalAlignment="Center" />
                    <Border x:Name="InboxBadge" Style="{StaticResource FmBadgeBorder}" Visibility="Collapsed">
                        <TextBlock x:Name="InboxBadgeText" FontSize="11"
                                   Foreground="{ThemeResource FmStatusWarningBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Style="{StaticResource FmTextBodySmall}"
                           Foreground="{ThemeResource FmTextSecondaryBrush}"
                           Text="Files the engine couldn't place confidently — a human decides." />
                <ListView x:Name="InboxList" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="12" Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Path}" FontSize="11"
                                               Foreground="{ThemeResource FmTextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Reason}" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{ThemeResource FmStatusWarningBrush}" />
                                    <TextBlock Text="{Binding Suggested}" FontSize="11"
                                               Foreground="{ThemeResource FmTextSecondaryBrush}"
                                               Visibility="{Binding SuggestedVisibility}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Top">
                                    <Button Content="Send to organized"
                                            Click="SendSuggested_Click" Tag="{Binding Id}"
                                            Visibility="{Binding SuggestedVisibility}" />
                                    <Button Content="Mark resolved" Click="ResolveRow_Click"
                                            Tag="{Binding Id}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="InboxEmpty" Style="{StaticResource FmTextBodySmall}"
                           Foreground="{ThemeResource FmTextSecondaryBrush}"
                           Text="Inbox is empty — everything pending your call is handled."
                           Visibility="Collapsed" />
            </StackPanel>

            <StackPanel Spacing="{StaticResource FmSpace2}">
                <TextBlock Text="Canonical operation states" Style="{StaticResource FmTextH2}" />
                <TextBlock Style="{StaticResource FmTextBodySmall}"
                           Foreground="{ThemeResource FmTextSecondaryBrush}"
                           Text="Every state pairs color with icon and label — never color alone." />
                <ItemsControl x:Name="Legend">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
