<Page
    x:Class="FileMind.WinUI.Views.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FileMind.WinUI.Controls">
    <Grid Padding="{StaticResource FmPad4}" RowSpacing="{StaticResource FmSpace3}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource FmSpace3}">
            <TextBlock Text="Activity" Style="{StaticResource FmTextH1}" VerticalAlignment="Center" />
            <Button Content="Refresh" Click="Refresh_Click" VerticalAlignment="Center" />
            <Button x:Name="UndoButton" Content="Undo selected" Click="Undo_Click"
                    VerticalAlignment="Center" IsEnabled="False" />
        </StackPanel>
        <Grid Grid.Row="1">
            <ListView x:Name="OpList" SelectionMode="Single" SelectionChanged="OpList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,6">
                            <c:FmStatusChip State="{Binding State}" />
                            <StackPanel>
                                <TextBlock Text="{Binding Summary}" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource FmTextBodySmall}"
                                           Foreground="{ThemeResource FmTextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <c:FmStateView x:Name="Empty" State="Empty" Title="No operations"
                Body="Operations you run appear here with live status."
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</Page>
