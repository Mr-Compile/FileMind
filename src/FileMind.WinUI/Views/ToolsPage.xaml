<Page
    x:Class="FileMind.WinUI.Views.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FileMind.WinUI.Controls">
    <ScrollViewer>
        <StackPanel Padding="{StaticResource FmPad6}" Spacing="{StaticResource FmSpace4}" MaxWidth="800">
            <TextBlock Text="Tools" Style="{StaticResource FmTextH1}" />
            <ItemsRepeater x:Name="ToolList">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <c:FmBentoCard Header="{Binding Name}" IconGlyph="{Binding Glyph}">
                            <c:FmBentoCard.CardContent>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <c:FmStatusChip State="{Binding State}" Detail="{Binding StateDetail}" />
                                    <TextBlock Text="{Binding Description}" VerticalAlignment="Center"
                                               Style="{StaticResource FmTextBodySmall}"
                                               Foreground="{ThemeResource FmTextSecondaryBrush}" />
                                </StackPanel>
                            </c:FmBentoCard.CardContent>
                        </c:FmBentoCard>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Page>
