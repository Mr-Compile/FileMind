<Page
    x:Class="FileMind.WinUI.Views.OrganizerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FileMind.WinUI.Controls">
    <ScrollViewer>
        <StackPanel Padding="{StaticResource FmPad6}" Spacing="{StaticResource FmSpace4}" MaxWidth="960">
            <TextBlock Text="Organizer" Style="{StaticResource FmTextH1}" />

            <!-- Step 1: select source + destination -->
            <c:FmBentoCard IconGlyph="&#xE8B7;" Header="Select">
                <c:FmBentoCard.CardContent>
                    <StackPanel Spacing="{StaticResource FmSpace3}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource FmSpace2}">
                            <TextBox x:Name="SourceBox" PlaceholderText="Source folder to organize" Width="420" />
                            <Button Content="Browse…" Click="BrowseSource_Click" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource FmSpace2}">
                            <TextBox x:Name="DestBox" PlaceholderText="Destination root" Width="420" />
                            <Button Content="Browse…" Click="BrowseDest_Click" />
                        </StackPanel>
                        <CheckBox x:Name="PreserveTree" Content="Preserve source folder tree inside categories" />
                        <Button Content="Analyze" Click="Analyze_Click" HorizontalAlignment="Left"
                                Style="{ThemeResource AccentButtonStyle}" />
                    </StackPanel>
                </c:FmBentoCard.CardContent>
            </c:FmBentoCard>

            <c:FmStateView x:Name="Busy" State="Loading" Title="Working" Visibility="Collapsed" />
            <c:FmStateView x:Name="Error" State="Error" Visibility="Collapsed" />

            <!-- Step 2+: plan preview + confirm -->
            <c:FmBentoCard x:Name="PlanCard" IconGlyph="&#xE8C7;" Header="Plan" Visibility="Collapsed">
                <c:FmBentoCard.CardContent>
                    <StackPanel Spacing="{StaticResource FmSpace3}">
                        <TextBlock x:Name="PlanSummary" Style="{StaticResource FmTextBody}" />
                        <ItemsRepeater x:Name="PlanList">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="2" Padding="0,4">
                                        <TextBlock Text="{Binding Label}" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource FmTextBodySmall}"
                                                   Foreground="{ThemeResource FmTextSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource FmSpace2}">
                            <Button x:Name="ExecuteButton" Content="Execute" Click="Execute_Click"
                                    Style="{ThemeResource AccentButtonStyle}" />
                            <Button x:Name="UndoButton" Content="Undo last run" Click="Undo_Click" Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                </c:FmBentoCard.CardContent>
            </c:FmBentoCard>

            <!-- result -->
            <c:FmBentoCard x:Name="ResultCard" IconGlyph="&#xE81C;" Header="Result" Visibility="Collapsed">
                <c:FmBentoCard.CardContent>
                    <StackPanel Spacing="{StaticResource FmSpace2}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource FmSpace2}">
                            <c:FmStatusChip x:Name="ResultChip" />
                            <TextBlock x:Name="ResultText" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </c:FmBentoCard.CardContent>
            </c:FmBentoCard>
        </StackPanel>
    </ScrollViewer>
</Page>
