<Page
    x:Class="FileMind.WinUI.Views.OrganizerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FileMind.WinUI.Controls">
    <!-- matched to mockup flows.js organizer: dry-run toggle + 7-step
         stepper (source → scan → analyze → plan → safety → execute →
         result), each step its own surface -->
    <Grid RowSpacing="{StaticResource FmSpace3}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- page-head: title + dry-run toggle (mockup .page-head + #o-dry) -->
        <Grid>
            <StackPanel>
                <TextBlock Text="Organizer" Style="{StaticResource FmTextH1}" />
                <TextBlock Style="{StaticResource FmTextBodySmall}"
                           Foreground="{ThemeResource FmTextSecondaryBrush}"
                           Text="The real pipeline, step by step: scan → analyze → plan → safety → execute → verify → history." />
            </StackPanel>
            <CheckBox x:Name="DryRunCheck" Content="Dry run" IsChecked="True"
                      HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <!-- stepper (mockup .steps) -->
        <ItemsControl x:Name="StepBar" Grid.Row="1">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="{StaticResource FmSpace4}" MaxWidth="1100">

                <c:FmStateView x:Name="Error" State="Error" Visibility="Collapsed" />

                <!-- ===== Step 1: source ===== -->
                <StackPanel x:Name="StepSource" Spacing="{StaticResource FmSpace4}">
                    <c:FmBentoCard IconGlyph="&#xE8B7;" Header="Pick a folder to organize">
                        <c:FmBentoCard.CardContent>
                            <StackPanel Spacing="{StaticResource FmSpace3}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource FmSpace2}">
                                    <TextBox x:Name="SourceBox" Width="480"
                                             PlaceholderText="Source folder (e.g. C:\Users\me\Downloads)" />
                                    <Button Content="Browse…" Click="BrowseSource_Click" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource FmSpace2}">
                                    <TextBox x:Name="DestBox" Width="480"
                                             PlaceholderText="Destination root — empty = &lt;source&gt;\organized" />
                                    <Button Content="Browse…" Click="BrowseDest_Click" />
                                </StackPanel>
                                <CheckBox x:Name="PreserveTree"
                                          Content="Keep folder structure — preserve relative subfolders under the destination" />
                            </StackPanel>
                        </c:FmBentoCard.CardContent>
                    </c:FmBentoCard>
                    <Button Content="Scan this folder" Click="Scan_Click"
                            Style="{ThemeResource AccentButtonStyle}"
                            HorizontalAlignment="Left" />
                </StackPanel>

                <!-- ===== Step 2: scan (streams like `filemind scan`) ===== -->
                <StackPanel x:Name="StepScan" Visibility="Collapsed"
                            Spacing="{StaticResource FmSpace3}">
                    <Border Background="{ThemeResource FmSurfacePrimaryBrush}"
                            BorderBrush="{ThemeResource FmBorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource FmRadiusMediumValue}" Height="280">
                        <ScrollViewer x:Name="ScanScroll">
                            <ItemsControl x:Name="ScanList" Margin="12,8" />
                        </ScrollViewer>
                    </Border>
                    <TextBlock x:Name="ScanSummary" Style="{StaticResource FmTextBodySmall}"
                               Foreground="{ThemeResource FmTextSecondaryBrush}" />
                    <Button x:Name="AnalyzeNext" Content="Analyze" Click="AnalyzeNext_Click"
                            Style="{ThemeResource AccentButtonStyle}"
                            HorizontalAlignment="Left" IsEnabled="False" />
                </StackPanel>

                <!-- ===== Step 3: analyze (per-file table + evidence) ===== -->
                <StackPanel x:Name="StepAnalyze" Visibility="Collapsed"
                            Spacing="{StaticResource FmSpace3}">
                    <StackPanel x:Name="AnalyzeChips" Orientation="Horizontal"
                                Spacing="8" />
                    <Border BorderBrush="{ThemeResource FmBorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource FmRadiusMediumValue}"
                            Background="{ThemeResource FmSurfacePrimaryBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border BorderBrush="{ThemeResource FmBorderBrush}"
                                    BorderThickness="0,0,0,1" Padding="12,8">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" /><ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="140" /><ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" /><ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Name" Style="{StaticResource FmTextH3}" />
                                    <TextBlock Grid.Column="1" Text="Kind" Style="{StaticResource FmTextH3}" />
                                    <TextBlock Grid.Column="2" Text="Confidence" Style="{StaticResource FmTextH3}" />
                                    <TextBlock Grid.Column="3" Text="Subject" Style="{StaticResource FmTextH3}" />
                                    <TextBlock Grid.Column="4" Text="Project" Style="{StaticResource FmTextH3}" />
                                    <TextBlock Grid.Column="5" Text="Decision" Style="{StaticResource FmTextH3}" />
                                </Grid>
                            </Border>
                            <ListView x:Name="AnalyzeList" Grid.Row="1"
                                      SelectionMode="None" MaxHeight="420">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Grid ColumnSpacing="16" Padding="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3*" /><ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="140" /><ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="110" /><ColumnDefinition Width="110" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding Kind}"
                                                           Foreground="{ThemeResource FmTextSecondaryBrush}" />
                                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                            Spacing="6" VerticalAlignment="Center">
                                                    <ProgressBar Value="{Binding Confidence}"
                                                                 Minimum="0" Maximum="100"
                                                                 Width="64" Height="6" />
                                                    <TextBlock Text="{Binding ConfText}" FontSize="11"
                                                               Foreground="{ThemeResource FmTextSecondaryBrush}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="3" Text="{Binding Subject}"
                                                           Foreground="{ThemeResource FmTextSecondaryBrush}" />
                                                <TextBlock Grid.Column="4" Text="{Binding Project}"
                                                           Foreground="{ThemeResource FmTextSecondaryBrush}" />
                                                <StackPanel Grid.Column="5" Orientation="Horizontal"
                                                            Spacing="6" VerticalAlignment="Center">
                                                    <Ellipse Width="6" Height="6" Fill="{Binding DecisionBrush}" />
                                                    <TextBlock Text="{Binding Decision}" FontSize="12"
                                                               Foreground="{Binding DecisionBrush}" />
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel x:Name="EvidencePanel" Visibility="Collapsed"
                                                        Margin="4,0,0,4" Spacing="2">
                                                <TextBlock Text="{Binding Reason}" FontSize="11"
                                                           Foreground="{ThemeResource FmTextSecondaryBrush}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Evidence}" FontSize="11"
                                                           FontFamily="Consolas" TextWrapping="Wrap"
                                                           Foreground="{ThemeResource FmTextSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                    <Button Content="Build action plan" Click="PlanNext_Click"
                            Style="{ThemeResource AccentButtonStyle}"
                            HorizontalAlignment="Left" />
                </StackPanel>

                <!-- ===== Step 4: plan ===== -->
                <StackPanel x:Name="StepPlan" Visibility="Collapsed"
                            Spacing="{StaticResource FmSpace3}">
                    <Border Background="{ThemeResource FmSurfacePrimaryBrush}"
                            BorderBrush="{ThemeResource FmBorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource FmRadiusMediumValue}" Padding="12,8">
                        <TextBlock x:Name="PlanHeader" FontFamily="Consolas" FontSize="12"
                                   Foreground="{ThemeResource FmTextSecondaryBrush}" />
                    </Border>
                    <Border BorderBrush="{ThemeResource FmBorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource FmRadiusMediumValue}"
                            Background="{ThemeResource FmSurfacePrimaryBrush}">
                        <ListView x:Name="PlanList" SelectionMode="None" MaxHeight="360">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="12" Padding="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" /><ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>
                                        <c:FmStatusChip State="{Binding State}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Source}" FontSize="12"
                                                   FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding Dest}" FontSize="12"
                                                   FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding Why}" FontSize="12"
                                                   Foreground="{ThemeResource FmTextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                    <TextBlock x:Name="PlanSkipped" Style="{StaticResource FmTextBodySmall}"
                               Foreground="{ThemeResource FmTextSecondaryBrush}" />
                    <Button Content="Run safety check" Click="SafetyNext_Click"
                            Style="{ThemeResource AccentButtonStyle}"
                            HorizontalAlignment="Left" />
                </StackPanel>

                <!-- ===== Step 5: safety ===== -->
                <StackPanel x:Name="StepSafety" Visibility="Collapsed"
                            Spacing="{StaticResource FmSpace3}">
                    <StackPanel x:Name="SafetyBanners" Spacing="{StaticResource FmSpace2}" />
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource FmSpace2}">
                        <Button x:Name="ExecuteButton" Content="Execute for real"
                                Click="Execute_Click" Style="{ThemeResource AccentButtonStyle}" />
                        <Button Content="Back to plan" Click="BackToPlan_Click" />
                    </StackPanel>
                </StackPanel>

                <!-- ===== Step 6: execute ===== -->
                <StackPanel x:Name="StepExecute" Visibility="Collapsed"
                            Spacing="{StaticResource FmSpace3}">
                    <c:FmBentoCard IconGlyph="&#xE81C;" Header="Running">
                        <c:FmBentoCard.CardContent>
                            <StackPanel Spacing="{StaticResource FmSpace3}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <c:FmStatusChip x:Name="RunStage" />
                                    <ProgressBar x:Name="RunBar" Width="280" Height="8"
                                                 Minimum="0" Maximum="100" />
                                    <TextBlock x:Name="RunCount" FontSize="12"
                                               Foreground="{ThemeResource FmTextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <ItemsControl x:Name="RunLog" />
                            </StackPanel>
                        </c:FmBentoCard.CardContent>
                    </c:FmBentoCard>
                    <Button Content="Cancel" Click="Cancel_Click"
                            HorizontalAlignment="Left" />
                </StackPanel>

                <!-- ===== Step 7: result ===== -->
                <StackPanel x:Name="StepResult" Visibility="Collapsed"
                            Spacing="{StaticResource FmSpace3}">
                    <c:FmBentoCard x:Name="ResultCard" IconGlyph="&#xE81C;" Header="Result">
                        <c:FmBentoCard.CardContent>
                            <StackPanel Spacing="{StaticResource FmSpace2}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <c:FmStatusChip x:Name="ResultChip" />
                                    <TextBlock x:Name="ResultText" VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock x:Name="ResultDetail" Style="{StaticResource FmTextBodySmall}"
                                           Foreground="{ThemeResource FmTextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </c:FmBentoCard.CardContent>
                    </c:FmBentoCard>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource FmSpace2}">
                        <Button x:Name="RunForReal" Content="Run for real"
                                Click="RunForReal_Click" Style="{ThemeResource AccentButtonStyle}"
                                Visibility="Collapsed" />
                        <Button x:Name="UndoButton" Content="Undo this run"
                                Click="Undo_Click" Visibility="Collapsed" />
                        <Button Content="Start over" Click="StartOver_Click" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
