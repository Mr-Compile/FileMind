<Page
    x:Class="FileMind.WinUI.Views.FilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FileMind.WinUI.Controls">
    <!-- matched to mockup screens.js "files": page-head → scope chips →
         filter chips → table + inspector → selection bar -->
    <Grid RowSpacing="{StaticResource FmSpace3}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- page-head -->
        <Grid>
            <StackPanel>
                <TextBlock Text="Files" Style="{StaticResource FmTextH1}" />
                <TextBlock Style="{StaticResource FmTextBodySmall}"
                           Foreground="{ThemeResource FmTextSecondaryBrush}"
                           Text="Indexed locations — filter, inspect, and organize from one table." />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource FmSpace2}"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Click="Index_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="12" /><TextBlock Text="Index folder…" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource AccentButtonStyle}" Click="Organize_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8F0;" FontSize="12" /><TextBlock Text="Organize" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- scope chips + count -->
        <Grid>
            <StackPanel x:Name="ScopeChips" Orientation="Horizontal" Spacing="8" />
            <TextBlock x:Name="ItemCount" Style="{StaticResource FmTextBodySmall}"
                       Foreground="{ThemeResource FmTextSecondaryBrush}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <!-- filter row: search + kind chips + sort -->
        <Grid>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBox x:Name="FilterBox" PlaceholderText="Search indexed files…" Width="220"
                         TextChanged="FilterBox_TextChanged" />
                <ItemsControl x:Name="KindChips">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="ClearBtn" Style="{StaticResource FmLinkButton}" Content="Clear all"
                        Click="Clear_Click" Visibility="Collapsed" />
                <ComboBox x:Name="SortBox" Width="110" Header="Sort" SelectionChanged="Sort_SelectionChanged">
                    <ComboBoxItem Content="Name" Tag="name" />
                    <ComboBoxItem Content="Kind" Tag="kind" />
                    <ComboBoxItem Content="Size" Tag="size" />
                    <ComboBoxItem Content="Modified" Tag="modified" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- table + inspector -->
        <Grid Grid.Row="3" ColumnSpacing="{StaticResource FmSpace3}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>
            <Border BorderBrush="{ThemeResource FmBorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource FmRadiusMediumValue}"
                    Background="{ThemeResource FmSurfacePrimaryBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- table header (mockup .tbl thead) -->
                    <Border BorderBrush="{ThemeResource FmBorderBrush}" BorderThickness="0,0,0,1"
                            Padding="12,8">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" /><ColumnDefinition Width="100" />
                                <ColumnDefinition Width="90" /><ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Name" Style="{StaticResource FmTextH3}" />
                            <TextBlock Grid.Column="1" Text="Type" Style="{StaticResource FmTextH3}" />
                            <TextBlock Grid.Column="2" Text="Size" Style="{StaticResource FmTextH3}" />
                            <TextBlock Grid.Column="3" Text="Modified" Style="{StaticResource FmTextH3}" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                        <ListView x:Name="FileList" SelectionMode="Extended"
                                  SelectionChanged="FileList_SelectionChanged">
                            <ListView.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Show in folder" Click="ShowInFolder_Click" />
                                    <MenuFlyoutItem Text="Copy path" Click="CopyPath_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Organize…" Click="Organize_Click" />
                                </MenuFlyout>
                            </ListView.ContextFlyout>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="16" Padding="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*" /><ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="90" /><ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Kind}"
                                                   Foreground="{ThemeResource FmTextSecondaryBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Size}"
                                                   Foreground="{ThemeResource FmTextSecondaryBrush}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Modified}"
                                                   Foreground="{ThemeResource FmTextSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <c:FmStateView x:Name="Empty" State="Empty" Title="Nothing indexed"
                            Body="Index a folder to browse it here. Use “Index folder…” above."
                            Visibility="Collapsed" />
                        <ProgressRing x:Name="Spinner" IsActive="True" Width="40" Height="40"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>

            <!-- inspector card (mockup #inspector) -->
            <c:FmBentoCard Grid.Column="1" x:Name="Inspector" IconGlyph="&#xE946;" Header="Details">
                <c:FmBentoCard.CardContent>
                    <StackPanel Spacing="{StaticResource FmSpace2}">
                        <TextBlock x:Name="InsName" Style="{StaticResource FmTextBody}"
                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="InsHint" Style="{StaticResource FmTextBodySmall}"
                                   Foreground="{ThemeResource FmTextSecondaryBrush}"
                                   Text="Select a file to see its classification, decision and evidence."
                                   TextWrapping="Wrap" />
                        <StackPanel x:Name="InsBody" Spacing="{StaticResource FmSpace2}" Visibility="Collapsed">
                            <TextBlock x:Name="InsPath" Style="{StaticResource FmTextBodySmall}"
                                       Foreground="{ThemeResource FmTextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="InsMeta" Style="{StaticResource FmTextBodySmall}"
                                       Foreground="{ThemeResource FmTextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Decision" Style="{StaticResource FmTextBodySmall}"
                                           VerticalAlignment="Center" />
                                <c:FmStatusChip x:Name="InsDecision" />
                            </StackPanel>
                            <TextBlock x:Name="InsReason" Style="{StaticResource FmTextBodySmall}"
                                       Foreground="{ThemeResource FmTextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="InsHash" Style="{StaticResource FmTextBodySmall}"
                                       Foreground="{ThemeResource FmTextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </c:FmBentoCard.CardContent>
            </c:FmBentoCard>
        </Grid>

        <!-- selection bar (mockup .selbar) -->
        <Border Grid.Row="4" x:Name="SelBar" Visibility="Collapsed"
                Background="{ThemeResource FmSurfacePrimaryBrush}"
                BorderBrush="{ThemeResource FmBorderBrush}" BorderThickness="1"
                CornerRadius="{StaticResource FmRadiusMediumValue}" Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock x:Name="SelCount" Style="{StaticResource FmTextBody}" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button Content="Organize…" Click="Organize_Click" />
                <Button Style="{StaticResource FmLinkButton}" Content="Clear selection" Click="ClearSel_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
