<Page
    x:Class="FileMind.WinUI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FileMind.WinUI.Controls">
    <ScrollViewer>
        <StackPanel Padding="{StaticResource FmPad6}" Spacing="{StaticResource FmSpace4}" MaxWidth="720">
            <TextBlock Text="Settings" Style="{StaticResource FmTextH1}" />

            <c:FmBentoCard IconGlyph="&#xE771;" Header="Appearance">
                <c:FmBentoCard.CardContent>
                    <StackPanel Spacing="{StaticResource FmSpace3}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource FmSpace3}">
                            <TextBlock x:Name="ThemeLabel" Text="Theme" Width="120" VerticalAlignment="Center" />
                            <ComboBox x:Name="ThemePicker" Width="200" AutomationProperties.LabeledBy="{Binding ElementName=ThemeLabel}" SelectionChanged="ThemePicker_SelectionChanged">
                                <ComboBoxItem Content="System" />
                                <ComboBoxItem Content="Light" />
                                <ComboBoxItem Content="Dark" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource FmSpace3}">
                            <TextBlock x:Name="DensityLabel" Text="Density" Width="120" VerticalAlignment="Center" />
                            <ComboBox x:Name="DensityPicker" Width="200" AutomationProperties.LabeledBy="{Binding ElementName=DensityLabel}" SelectionChanged="DensityPicker_SelectionChanged">
                                <ComboBoxItem Content="Comfortable" />
                                <ComboBoxItem Content="Compact" />
                            </ComboBox>
                        </StackPanel>
                        <TextBlock x:Name="MotionNote" Style="{StaticResource FmTextBodySmall}"
                                   Foreground="{ThemeResource FmTextSecondaryBrush}" />
                    </StackPanel>
                </c:FmBentoCard.CardContent>
            </c:FmBentoCard>

            <c:FmBentoCard IconGlyph="&#xE8F0;" Header="Organization">
                <c:FmBentoCard.CardContent>
                    <StackPanel Spacing="{StaticResource FmSpace2}">
                        <TextBlock x:Name="ModeText" Style="{StaticResource FmTextBody}" />
                        <TextBlock Style="{StaticResource FmTextBodySmall}"
                                   Foreground="{ThemeResource FmTextSecondaryBrush}"
                                   Text="Mode changes go through the host `mode` verb — the UI displays the current policy."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </c:FmBentoCard.CardContent>
            </c:FmBentoCard>
        </StackPanel>
    </ScrollViewer>
</Page>
