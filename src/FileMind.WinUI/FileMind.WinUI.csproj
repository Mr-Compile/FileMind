<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>FileMind.WinUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- MSIX single-project packaging: Smart App Control on this box blocks
         unsigned per-hash image loads (CodeIntegrity 3077), so the dev/test
         path is a signed MSIX installed per-user. -->
    <WindowsPackageType>SingleProjectMSIX</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
    <PackageCertificateKeyFile>C:\tmp\fm-dev-sign.pfx</PackageCertificateKeyFile>
    <PackageCertificatePassword>fmdev</PackageCertificatePassword>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableMsixTooling>false</EnableMsixTooling>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
  </ItemGroup>

  <!-- Smart App Control blocks unsigned FileMind.*.dll image loads
       (CodeIntegrity 3077). Dev-box remedy: sign build outputs with the
       local dev cert — see tools/fm-sign.ps1 (documented in PLAN-014). -->
  <ItemGroup>
    <ProjectReference Include="..\FileMind.Branding\FileMind.Branding.csproj" />
    <ProjectReference Include="..\FileMind.Domain\FileMind.Domain.csproj" />
    <ProjectReference Include="..\FileMind.Application\FileMind.Application.csproj" />
    <ProjectReference Include="..\FileMind.Infrastructure.Sqlite\FileMind.Infrastructure.Sqlite.csproj" />
    <ProjectReference Include="..\FileMind.Platform.Windows\FileMind.Platform.Windows.csproj" />
    <ProjectReference Include="..\FileMind.Intelligence.Local\FileMind.Intelligence.Local.csproj" />
    <ProjectReference Include="..\FileMind.Intelligence.AI\FileMind.Intelligence.AI.csproj" />
  </ItemGroup>
</Project>
