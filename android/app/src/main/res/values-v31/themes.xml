<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ splash. Deviation from branding/logo/android/res/values-v31:
     postSplashScreenTheme is a core-splashscreen library attr (not
     android:*) and the parent is Theme.SplashScreen so the compat lib can
     hand off cleanly. Brand rule preserved: simple/fast, no fake progress. -->
<resources>
    <style name="Theme.FileMind.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.FileMind</item>
    </style>
</resources>
