<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31) splash theme reference.
     Usage: apply Theme.FileMind.Splash to the launcher activity, then
     setTheme(Theme.FileMind) in super.onCreate — splash dismisses into app.
     Brand rule: splash stays simple/fast; no fake determinate progress. -->
<resources>
    <style name="Theme.FileMind.Splash" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">300</item>
        <item name="android:postSplashScreenTheme">@style/Theme.FileMind</item>
    </style>
</resources>
